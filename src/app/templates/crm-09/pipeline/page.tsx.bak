'use client';

import React from 'react';
import { getTemplateBySlug, getAdjacentTemplates } from '@/lib/registry';
import { CrmLayout } from '@/components/crm-layout/CrmLayout';
import { GOV_PHASES, LARGE_DEALS, RISK_DONUT, CLOSE_TIMELINE, APPROVAL_QUEUE } from '../data';

const accent = '#3b82f6';
const card: React.CSSProperties = { background: '#1e293b', border: '1px solid rgba(59,130,246,0.1)', borderRadius: 8, padding: '20px 24px' };
const lbl: React.CSSProperties = { fontSize: '0.625rem', fontWeight: 700, color: '#64748b', textTransform: 'uppercase', letterSpacing: '0.08em', marginBottom: 14 };

function PipelineContent() {
    const maxPhase = Math.max(...GOV_PHASES.map(p => p.value));
    const riskColor = (t: string) => t === 'High' ? '#ef4444' : t === 'Medium' ? '#f59e0b' : '#22c55e';
    const approvalColor = (s: string) => s === 'Approved' ? '#22c55e' : s === 'Pending' ? '#f59e0b' : '#ef4444';
    const totalDonut = RISK_DONUT.reduce((s, d) => s + d.value, 0);
    const closeDayColor = (d: number) => d < 30 ? '#22c55e' : d < 90 ? '#f59e0b' : '#94a3b8';
    const maxDays = Math.max(...CLOSE_TIMELINE.map(c => c.days));

    return (
        <div style={{ background: '#0f172a', minHeight: '100vh' }}>
            {/* Approval Workflow Ribbon */}
            <div style={{ borderBottom: '1px solid rgba(59,130,246,0.08)' }}>
                <div style={{ padding: '10px 32px', background: `${accent}06`, display: 'flex', flexDirection: 'column', gap: 4, fontSize: '0.6875rem' }}>
                    <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                        <span style={{ color: '#f59e0b' }}>
                            <strong>PENDING APPROVAL:</strong> {APPROVAL_QUEUE.pending} Strategic Revenue Assets require executive review · <span style={{ cursor: 'pointer', textDecoration: 'underline' }}>View Queue →</span>
                        </span>
                    </div>
                    <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                        <span style={{ color: '#22c55e' }}>
                            <strong>APPROVED THIS WEEK:</strong> {APPROVAL_QUEUE.approvedThisWeek} assets advanced governance phase · <span style={{ color: '#94a3b8' }}>Deal #{APPROVAL_QUEUE.lastApproved.id} Approved: {APPROVAL_QUEUE.lastApproved.value} →</span>
                        </span>
                    </div>
                </div>
            </div>

            <div style={{ padding: '24px 32px', maxWidth: 1400, margin: '0 auto' }}>
                <div style={{ marginBottom: 24 }}>
                    <h1 style={{ fontSize: '1.375rem', fontWeight: 700, color: '#e2e8f0', margin: 0 }}>Governed Opportunity Portfolio</h1>
                    <p style={{ fontSize: '0.75rem', color: '#64748b', margin: '4px 0 0' }}>Governance phases · Large deal tracker · Risk exposure · Close timeline</p>
                </div>

                {/* Metrics */}
                <div style={{ display: 'grid', gridTemplateColumns: 'repeat(3,1fr)', gap: 14, marginBottom: 20 }}>
                    {[
                        { label: 'Commit Revenue', value: '$44M', color: accent },
                        { label: 'Upside Revenue', value: '$28M', color: '#f59e0b' },
                        { label: 'At-Risk Revenue', value: '$12M', color: '#ef4444' },
                    ].map(m => (
                        <div key={m.label} style={{ ...card, transition: 'all 0.2s', cursor: 'default' }}
                            onMouseEnter={e => { (e.currentTarget as HTMLDivElement).style.borderColor = `${m.color}45`; (e.currentTarget as HTMLDivElement).style.transform = 'translateY(-2px)'; }}
                            onMouseLeave={e => { (e.currentTarget as HTMLDivElement).style.borderColor = 'rgba(59,130,246,0.1)'; (e.currentTarget as HTMLDivElement).style.transform = 'none'; }}>
                            <div style={{ fontSize: '0.5rem', color: '#64748b', textTransform: 'uppercase', letterSpacing: '0.08em', marginBottom: 6, fontWeight: 700 }}>{m.label}</div>
                            <div style={{ fontSize: '2rem', fontWeight: 800, color: m.color, letterSpacing: '-0.03em', lineHeight: 1 }}>{m.value}</div>
                        </div>
                    ))}
                </div>

                {/* Row 1: Phase Distribution + Large Deal Tracker */}
                <div style={{ display: 'grid', gridTemplateColumns: '1fr 1.5fr', gap: 20, marginBottom: 20 }}>
                    {/* Governance Phase Distribution */}
                    <div style={card}>
                        <div style={lbl}>Revenue Governance Phase Distribution</div>
                        <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
                            {GOV_PHASES.map(p => (
                                <div key={p.phase}>
                                    <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: 3 }}>
                                        <span style={{ fontSize: '0.6875rem', color: '#94a3b8', fontWeight: 500 }}>{p.phase}</span>
                                        <span style={{ fontSize: '0.625rem', color: accent, fontWeight: 700 }}>${p.value}M · {p.count} assets</span>
                                    </div>
                                    <div style={{ height: 10, background: 'rgba(255,255,255,0.04)', borderRadius: 3 }}>
                                        <div style={{ width: `${(p.value / maxPhase) * 100}%`, height: '100%', background: accent, borderRadius: 3, opacity: 0.8, transition: 'all 0.2s' }} />
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>

                    {/* Large Deal Tracker */}
                    <div style={card}>
                        <div style={lbl}>Large Deal Tracker — Strategic Revenue Assets</div>
                        <div style={{ overflowX: 'auto' }}>
                            <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: '0.625rem' }}>
                                <thead>
                                    <tr style={{ background: '#0f172a' }}>
                                        {['Account', 'ARR', 'Phase', 'Exec Sponsor', 'Risk', 'Approval', 'Close Q'].map(h => (
                                            <th key={h} style={{ padding: '6px 8px', textAlign: 'left', fontWeight: 700, color: '#64748b', fontSize: '0.45rem', textTransform: 'uppercase', letterSpacing: '0.06em', whiteSpace: 'nowrap' }}>{h}</th>
                                        ))}
                                    </tr>
                                </thead>
                                <tbody>
                                    {LARGE_DEALS.map(deal => (
                                        <tr key={deal.account} style={{
                                            borderTop: '1px solid rgba(255,255,255,0.04)',
                                            borderLeft: parseFloat(deal.arr.replace(/[^0-9.]/g, '')) > 3 ? `2px solid #f59e0b` : '2px solid transparent',
                                            transition: 'background 0.15s', cursor: 'pointer',
                                        }}
                                            onMouseEnter={e => (e.currentTarget as HTMLTableRowElement).style.background = 'rgba(255,255,255,0.02)'}
                                            onMouseLeave={e => (e.currentTarget as HTMLTableRowElement).style.background = 'transparent'}>
                                            <td style={{ padding: '7px 8px', fontWeight: 600, color: '#e2e8f0', whiteSpace: 'nowrap' }}>{deal.account}</td>
                                            <td style={{ padding: '7px 8px', fontWeight: 700, color: accent }}>{deal.arr}</td>
                                            <td style={{ padding: '7px 8px', color: '#94a3b8' }}>{deal.phase}</td>
                                            <td style={{ padding: '7px 8px', color: '#64748b' }}>{deal.sponsor}</td>
                                            <td style={{ padding: '7px 8px' }}>
                                                <span style={{ padding: '1px 6px', borderRadius: 3, fontSize: '0.4375rem', fontWeight: 700, background: `${riskColor(deal.risk)}15`, color: riskColor(deal.risk) }}>{deal.risk}</span>
                                            </td>
                                            <td style={{ padding: '7px 8px' }}>
                                                <span style={{ padding: '1px 6px', borderRadius: 3, fontSize: '0.4375rem', fontWeight: 700, background: `${approvalColor(deal.approval)}15`, color: approvalColor(deal.approval) }}>{deal.approval}</span>
                                            </td>
                                            <td style={{ padding: '7px 8px', color: '#64748b', fontFamily: 'monospace', fontSize: '0.5625rem' }}>{deal.closeQ}</td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                {/* Row 2: Risk Donut + Close Timeline */}
                <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 20 }}>
                    {/* Risk Exposure Donut */}
                    <div style={card}>
                        <div style={lbl}>Pipeline Risk Exposure Distribution</div>
                        <div style={{ display: 'flex', gap: 24, alignItems: 'center' }}>
                            <svg width={150} height={150} viewBox="0 0 150 150" style={{ flexShrink: 0 }}>
                                {(() => {
                                    let offset = 0;
                                    const r = 55, cx = 75, cy = 75, circ = 2 * Math.PI * r;
                                    return RISK_DONUT.map(seg => {
                                        const pct = seg.value / totalDonut;
                                        const dash = pct * circ;
                                        const gap = circ - dash;
                                        const rotate = offset * 360 - 90;
                                        offset += pct;
                                        return (
                                            <circle key={seg.label} cx={cx} cy={cy} r={r} fill="none"
                                                stroke={seg.color} strokeWidth={18}
                                                strokeDasharray={`${dash} ${gap}`}
                                                transform={`rotate(${rotate} ${cx} ${cy})`}
                                                style={{ transition: 'all 0.3s', cursor: 'pointer' }}
                                                onMouseEnter={e => (e.target as SVGCircleElement).setAttribute('stroke-width', '22')}
                                                onMouseLeave={e => (e.target as SVGCircleElement).setAttribute('stroke-width', '18')}>
                                                <title>{seg.label}: {seg.value}%</title>
                                            </circle>
                                        );
                                    });
                                })()}
                                <text x={75} y={71} textAnchor="middle" fontSize={18} fontWeight={800} fill="#e2e8f0" fontFamily="Inter, sans-serif">$84M</text>
                                <text x={75} y={86} textAnchor="middle" fontSize={8} fill="#64748b" fontFamily="Inter, sans-serif">total pipeline</text>
                            </svg>
                            <div style={{ flex: 1 }}>
                                {RISK_DONUT.map(seg => (
                                    <div key={seg.label} style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 10 }}>
                                        <div style={{ display: 'flex', alignItems: 'center', gap: 6 }}>
                                            <div style={{ width: 10, height: 10, borderRadius: 2, background: seg.color }} />
                                            <span style={{ fontSize: '0.6875rem', color: '#94a3b8' }}>{seg.label}</span>
                                        </div>
                                        <span style={{ fontWeight: 700, color: seg.color, fontSize: '0.875rem' }}>{seg.value}%</span>
                                    </div>
                                ))}
                            </div>
                        </div>
                    </div>

                    {/* Close Date Timeline */}
                    <div style={card}>
                        <div style={lbl}>Close Date Proximity — Strategic Assets</div>
                        <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
                            {CLOSE_TIMELINE.map(c => (
                                <div key={c.asset} style={{ display: 'grid', gridTemplateColumns: '130px 1fr 60px', gap: 8, alignItems: 'center' }}>
                                    <span style={{ fontSize: '0.5625rem', color: '#94a3b8', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{c.asset}</span>
                                    <div style={{ height: 8, background: 'rgba(255,255,255,0.04)', borderRadius: 3 }}>
                                        <div style={{ width: `${(c.days / maxDays) * 100}%`, height: '100%', background: closeDayColor(c.days), borderRadius: 3, opacity: 0.8 }} />
                                    </div>
                                    <span style={{ fontSize: '0.5625rem', color: closeDayColor(c.days), fontWeight: 600, textAlign: 'right' }}>{c.days}d</span>
                                </div>
                            ))}
                        </div>
                        <div style={{ display: 'flex', gap: 14, marginTop: 12 }}>
                            {[['<30d (Hot)', '#22c55e'], ['30-90d', '#f59e0b'], ['90d+', '#94a3b8']].map(([l, c]) => (
                                <div key={l} style={{ display: 'flex', alignItems: 'center', gap: 4 }}>
                                    <div style={{ width: 8, height: 8, borderRadius: 2, background: c }} />
                                    <span style={{ fontSize: '0.45rem', color: '#64748b' }}>{l}</span>
                                </div>
                            ))}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    );
}

export default function Pipeline09Page() {
    const template = getTemplateBySlug('crm-09');
    if (!template) return null;
    const { prev, next } = getAdjacentTemplates('crm-09');
    return (
        <CrmLayout template={template} prevTemplate={prev} nextTemplate={next} currentPage="pipeline" accentColor={accent}>
            <PipelineContent />
        </CrmLayout>
    );
}
