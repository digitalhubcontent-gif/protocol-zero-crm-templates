'use client';

import React, { useState } from 'react';
import { getTemplateBySlug, getAdjacentTemplates } from '@/lib/registry';
import { CrmLayout } from '@/components/crm-layout/CrmLayout';
import { BOARD_REPORTS } from '../data';

const accent = '#3b82f6';
const card: React.CSSProperties = { background: '#1e293b', border: '1px solid rgba(59,130,246,0.1)', borderRadius: 8, padding: '24px 28px' };

function ReportsContent() {
    const [selectedReport, setSelectedReport] = useState<string | null>(null);

    return (
        <div style={{ background: '#0f172a', minHeight: '100vh' }}>
            <div style={{ padding: '28px 32px', maxWidth: 1400, margin: '0 auto' }}>
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 24 }}>
                    <div>
                        <h1 style={{ fontSize: '1.375rem', fontWeight: 700, color: '#e2e8f0', margin: 0 }}>Board-Grade Reporting</h1>
                        <p style={{ fontSize: '0.75rem', color: '#64748b', margin: '4px 0 0' }}>Quarterly reviews · Regional performance · Risk exposure · Forecast variance</p>
                    </div>
                    <div style={{ display: 'flex', gap: 8 }}>
                        <button style={{ padding: '7px 14px', borderRadius: 5, cursor: 'pointer', fontSize: '0.6875rem', fontWeight: 600, background: accent, color: '#fff', border: 'none' }}>Board Mode</button>
                        <button style={{ padding: '7px 14px', borderRadius: 5, cursor: 'pointer', fontSize: '0.6875rem', fontWeight: 600, background: 'transparent', color: '#94a3b8', border: '1px solid rgba(59,130,246,0.1)' }}>Schedule Quarterly</button>
                    </div>
                </div>

                <div style={{ display: 'grid', gridTemplateColumns: 'repeat(3, 1fr)', gap: 16 }}>
                    {BOARD_REPORTS.map(report => {
                        const isSelected = selectedReport === report.id;
                        return (
                            <div key={report.id}
                                onClick={() => setSelectedReport(isSelected ? null : report.id)}
                                style={{
                                    ...card,
                                    cursor: 'pointer', transition: 'all 0.2s',
                                    borderColor: isSelected ? accent : 'rgba(59,130,246,0.1)',
                                    transform: isSelected ? 'translateY(-4px)' : 'none',
                                    boxShadow: isSelected ? `0 12px 32px ${accent}15` : 'none',
                                }}>
                                <div style={{ fontSize: '2rem', marginBottom: 12 }}>{report.icon}</div>
                                <div style={{ fontSize: '0.875rem', fontWeight: 700, color: '#e2e8f0', marginBottom: 6 }}>{report.name}</div>
                                <p style={{ fontSize: '0.625rem', color: '#64748b', lineHeight: 1.7, marginBottom: 16, minHeight: 36 }}>{report.desc}</p>
                                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                                    <span style={{ fontSize: '0.5rem', color: '#475569' }}>Last: {report.lastGenerated}</span>
                                    <div style={{ display: 'flex', gap: 6 }}>
                                        <button style={{ padding: '4px 10px', borderRadius: 4, fontSize: '0.5625rem', fontWeight: 600, background: `${accent}15`, color: accent, border: 'none', cursor: 'pointer' }}>Export PDF</button>
                                        <button style={{ padding: '4px 10px', borderRadius: 4, fontSize: '0.5625rem', fontWeight: 600, background: 'transparent', color: '#94a3b8', border: '1px solid rgba(255,255,255,0.06)', cursor: 'pointer' }}>Preview</button>
                                    </div>
                                </div>
                            </div>
                        );
                    })}
                </div>

                {/* Report Preview Panel */}
                {selectedReport && (
                    <div style={{
                        marginTop: 24, ...card,
                        borderColor: `${accent}30`,
                    }}>
                        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 16 }}>
                            <div style={{ fontSize: '0.625rem', fontWeight: 700, color: '#64748b', textTransform: 'uppercase', letterSpacing: '0.08em' }}>
                                Report Preview — {BOARD_REPORTS.find(r => r.id === selectedReport)?.name}
                            </div>
                            <button onClick={() => setSelectedReport(null)} style={{ background: 'none', border: 'none', color: '#94a3b8', cursor: 'pointer', fontSize: '0.75rem' }}>✕</button>
                        </div>
                        <div style={{ height: 200, display: 'flex', alignItems: 'center', justifyContent: 'center', background: '#0f172a', borderRadius: 6, border: '1px dashed rgba(59,130,246,0.15)' }}>
                            <div style={{ textAlign: 'center' }}>
                                <div style={{ fontSize: '1.5rem', marginBottom: 8 }}>{BOARD_REPORTS.find(r => r.id === selectedReport)?.icon}</div>
                                <div style={{ fontSize: '0.75rem', color: '#94a3b8', fontWeight: 600, marginBottom: 4 }}>{BOARD_REPORTS.find(r => r.id === selectedReport)?.name}</div>
                                <div style={{ fontSize: '0.625rem', color: '#475569' }}>Board-grade report preview would render here</div>
                                <button style={{ marginTop: 12, padding: '8px 20px', borderRadius: 5, background: accent, color: '#fff', border: 'none', fontSize: '0.6875rem', fontWeight: 700, cursor: 'pointer' }}>Generate Full Report</button>
                            </div>
                        </div>
                    </div>
                )}
            </div>
        </div>
    );
}

export default function Reports09Page() {
    const template = getTemplateBySlug('crm-09');
    if (!template) return null;
    const { prev, next } = getAdjacentTemplates('crm-09');
    return (
        <CrmLayout template={template} prevTemplate={prev} nextTemplate={next} currentPage="reports" accentColor={accent}>
            <ReportsContent />
        </CrmLayout>
    );
}
