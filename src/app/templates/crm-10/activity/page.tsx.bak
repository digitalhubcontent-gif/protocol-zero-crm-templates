'use client';

import React from 'react';
import { getTemplateBySlug, getAdjacentTemplates } from '@/lib/registry';
import { CrmLayout } from '@/components/crm-layout/CrmLayout';
import { COMPLIANCE_EVENTS, DATA_FLOW_MONITORING } from '../data';

const accent = '#10b981';
const card: React.CSSProperties = { background: '#111827', border: '1px solid rgba(16,185,129,0.08)', borderRadius: 8, padding: '20px 24px' };
const lbl: React.CSSProperties = { fontSize: '0.625rem', fontWeight: 700, color: '#4b5563', textTransform: 'uppercase', letterSpacing: '0.08em', marginBottom: 14 };

function ActivityContent() {
    const eventColor = (r: string) => r === 'pass' ? '#10b981' : r === 'fail' ? '#ef4444' : r === 'warning' ? '#f59e0b' : '#6b7280';
    const eventIcon = (t: string) => t === 'scan' ? '🔍' : t === 'violation' ? '⚠️' : t === 'approval' ? '✅' : t === 'policy' ? '📋' : t === 'audit' ? '📊' : '📝';
    const flowColor = (s: string) => s === 'healthy' ? '#10b981' : '#f59e0b';

    return (
        <div style={{ background: '#030712', minHeight: '100vh' }}>
            <div style={{ padding: '28px 32px', maxWidth: 1400, margin: '0 auto' }}>
                <div style={{ marginBottom: 24 }}>
                    <h1 style={{ fontSize: '1.375rem', fontWeight: 700, color: '#f9fafb', margin: 0 }}>Regulated Interaction Log</h1>
                    <p style={{ fontSize: '0.75rem', color: '#4b5563', margin: '4px 0 0' }}>Compliance events · Data flow monitoring · Policy enforcement · Audit verification</p>
                </div>

                {/* Activity Summary */}
                <div style={{
                    background: 'rgba(16,185,129,0.04)', border: '1px solid rgba(16,185,129,0.1)', borderRadius: 8,
                    padding: '12px 20px', marginBottom: 20, fontFamily: 'monospace', fontSize: '0.6875rem',
                    color: '#6b7280', display: 'flex', gap: 24, flexWrap: 'wrap',
                }}>
                    <span><strong style={{ color: '#d1d5db' }}>Last 7 Days:</strong></span>
                    <span style={{ color: accent }}>12 Compliance Scans (all passed)</span>
                    <span>·</span>
                    <span style={{ color: '#f59e0b' }}>2 Violations Detected</span>
                    <span>·</span>
                    <span>4 Policy Updates Applied</span>
                    <span>·</span>
                    <span>3 Executive Approvals Logged</span>
                </div>

                {/* Row 1: Compliance Event Timeline + Data Flow */}
                <div style={{ display: 'grid', gridTemplateColumns: '1.3fr 1fr', gap: 20, marginBottom: 20 }}>
                    {/* Compliance Event Timeline */}
                    <div style={card}>
                        <div style={lbl}>Compliance Event Timeline</div>
                        <div style={{ display: 'flex', flexDirection: 'column', gap: 0 }}>
                            {COMPLIANCE_EVENTS.map((event, i) => (
                                <div key={i} style={{
                                    display: 'grid', gridTemplateColumns: '80px 24px 1fr',
                                    gap: 10, alignItems: 'center', padding: '8px 0',
                                    borderTop: i > 0 ? '1px solid rgba(255,255,255,0.03)' : 'none',
                                    borderLeft: event.result === 'fail' ? '2px solid #ef4444' : '2px solid transparent',
                                    paddingLeft: 8,
                                }}>
                                    <span style={{ fontSize: '0.5rem', color: '#4b5563', fontFamily: 'monospace' }}>{event.date}</span>
                                    <span style={{ fontSize: '1rem' }}>{eventIcon(event.type)}</span>
                                    <div>
                                        <div style={{ fontSize: '0.6875rem', color: '#d1d5db', fontWeight: 500 }}>{event.title}</div>
                                        <span style={{ fontSize: '0.5rem', color: eventColor(event.result), fontWeight: 700 }}>
                                            {event.result.toUpperCase()}
                                        </span>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>

                    {/* Data Flow Monitoring */}
                    <div style={card}>
                        <div style={lbl}>Data Flow Monitoring</div>
                        <div style={{ display: 'flex', flexDirection: 'column', gap: 10 }}>
                            {DATA_FLOW_MONITORING.map((flow, i) => (
                                <div key={i} style={{
                                    padding: '12px 14px',
                                    background: '#030712', borderRadius: 6,
                                    border: `1px solid ${flow.status === 'warning' ? '#f59e0b15' : 'rgba(255,255,255,0.04)'}`,
                                }}>
                                    <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 6 }}>
                                        <span style={{ fontSize: '0.6875rem', fontWeight: 600, color: '#d1d5db' }}>{flow.source} → {flow.destination}</span>
                                        <span style={{ display: 'flex', alignItems: 'center', gap: 4 }}>
                                            <span style={{ width: 6, height: 6, borderRadius: '50%', background: flowColor(flow.status), display: 'inline-block' }} />
                                            <span style={{ fontSize: '0.5rem', color: flowColor(flow.status), fontWeight: 700 }}>{flow.status.toUpperCase()}</span>
                                        </span>
                                    </div>
                                    <div style={{ display: 'flex', gap: 12, fontSize: '0.5625rem', color: '#6b7280' }}>
                                        <span>{flow.encrypted ? '🔒 Encrypted' : '⚠️ Unencrypted'}</span>
                                        <span>Volume: {flow.volume}</span>
                                    </div>
                                </div>
                            ))}
                        </div>
                        <div style={{ marginTop: 12, padding: '6px 12px', background: '#f59e0b08', borderRadius: 4, fontSize: '0.5625rem', color: '#f59e0b', fontWeight: 500 }}>
                            ⚠ Warning: APAC Records flow is unencrypted — remediation required
                        </div>
                    </div>
                </div>
            </div>
        </div>
    );
}

export default function Activity10Page() {
    const template = getTemplateBySlug('crm-10');
    if (!template) return null;
    const { prev, next } = getAdjacentTemplates('crm-10');
    return (
        <CrmLayout template={template} prevTemplate={prev} nextTemplate={next} currentPage="activity" accentColor={accent}>
            <ActivityContent />
        </CrmLayout>
    );
}
