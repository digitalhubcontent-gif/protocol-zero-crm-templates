'use client';

import React, { useState } from 'react';
import { getTemplateBySlug, getAdjacentTemplates } from '@/lib/registry';
import { CrmLayout } from '@/components/crm-layout/CrmLayout';
import { POLICY_RULES } from '../data';

const accent = '#10b981';
const card: React.CSSProperties = { background: '#111827', border: '1px solid rgba(16,185,129,0.08)', borderRadius: 8, padding: '20px 24px' };

function AutomationContent() {
    const [expandedRule, setExpandedRule] = useState<string | null>(null);

    return (
        <div style={{ background: '#030712', minHeight: '100vh' }}>
            <div style={{ padding: '28px 32px', maxWidth: 1400, margin: '0 auto' }}>
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 24 }}>
                    <div>
                        <h1 style={{ fontSize: '1.375rem', fontWeight: 700, color: '#f9fafb', margin: 0 }}>Policy Enforcement Engine</h1>
                        <p style={{ fontSize: '0.75rem', color: '#4b5563', margin: '4px 0 0' }}>Data classification · Compliance gates · Violation escalation · Audit integrity</p>
                    </div>
                    <button style={{ padding: '7px 16px', borderRadius: 5, cursor: 'pointer', fontSize: '0.6875rem', fontWeight: 700, background: accent, color: '#fff', border: 'none' }}>+ Create Policy</button>
                </div>

                {/* Stats */}
                <div style={{ display: 'grid', gridTemplateColumns: 'repeat(3,1fr)', gap: 14, marginBottom: 24 }}>
                    {[
                        { label: 'Active Policies', value: '5', color: accent },
                        { label: 'Total Executions', value: '577', color: '#22c55e' },
                        { label: 'Policy Compliance', value: '100%', color: '#06b6d4' },
                    ].map(m => (
                        <div key={m.label} style={{ ...card }}>
                            <div style={{ fontSize: '0.5rem', color: '#4b5563', textTransform: 'uppercase', letterSpacing: '0.08em', marginBottom: 6, fontWeight: 700 }}>{m.label}</div>
                            <div style={{ fontSize: '1.75rem', fontWeight: 800, color: m.color, letterSpacing: '-0.03em' }}>{m.value}</div>
                        </div>
                    ))}
                </div>

                {/* Policy Rules */}
                <div style={{ display: 'flex', flexDirection: 'column', gap: 12 }}>
                    {POLICY_RULES.map(rule => (
                        <div key={rule.id}
                            style={{
                                ...card, cursor: 'pointer', transition: 'all 0.15s',
                                borderColor: expandedRule === rule.id ? `${accent}40` : 'rgba(16,185,129,0.08)',
                            }}
                            onClick={() => setExpandedRule(expandedRule === rule.id ? null : rule.id)}>
                            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start' }}>
                                <div style={{ flex: 1 }}>
                                    <div style={{ display: 'flex', alignItems: 'center', gap: 10, marginBottom: 6 }}>
                                        <span style={{ fontSize: '0.875rem', fontWeight: 700, color: '#f9fafb' }}>{rule.name}</span>
                                        <span style={{
                                            padding: '2px 8px', borderRadius: 10, fontSize: '0.5rem', fontWeight: 700,
                                            background: `${accent}18`, color: accent,
                                        }}>{rule.status.toUpperCase()}</span>
                                    </div>
                                    <div style={{ fontSize: '0.6875rem', color: '#9ca3af', marginBottom: 8 }}>
                                        <strong style={{ color: '#ef4444' }}>TRIGGER:</strong> {rule.trigger}
                                    </div>
                                    <div style={{ fontSize: '0.6875rem', color: '#9ca3af' }}>
                                        <strong style={{ color: accent }}>ENFORCE:</strong> {rule.actions.join(' → ')}
                                    </div>
                                </div>
                                <div style={{ textAlign: 'right', flexShrink: 0 }}>
                                    <div style={{ fontSize: '1.25rem', fontWeight: 700, color: accent }}>{rule.executions}</div>
                                    <div style={{ fontSize: '0.5rem', color: '#4b5563' }}>executions</div>
                                    <div style={{ fontSize: '0.5rem', color: '#374151', marginTop: 4 }}>Last: {rule.lastRun}</div>
                                </div>
                            </div>
                            {expandedRule === rule.id && (
                                <div style={{ marginTop: 16, paddingTop: 16, borderTop: '1px solid rgba(16,185,129,0.08)', display: 'flex', gap: 10 }}>
                                    <button style={{ padding: '6px 14px', borderRadius: 4, fontSize: '0.625rem', fontWeight: 600, background: `${accent}15`, color: accent, border: 'none', cursor: 'pointer' }}>Edit Policy</button>
                                    <button style={{ padding: '6px 14px', borderRadius: 4, fontSize: '0.625rem', fontWeight: 600, background: 'transparent', color: '#9ca3af', border: '1px solid rgba(255,255,255,0.06)', cursor: 'pointer' }}>View Execution Log</button>
                                    <button style={{ padding: '6px 14px', borderRadius: 4, fontSize: '0.625rem', fontWeight: 600, background: 'transparent', color: '#9ca3af', border: '1px solid rgba(255,255,255,0.06)', cursor: 'pointer' }}>Test Run</button>
                                </div>
                            )}
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
}

export default function Automation10Page() {
    const template = getTemplateBySlug('crm-10');
    if (!template) return null;
    const { prev, next } = getAdjacentTemplates('crm-10');
    return (
        <CrmLayout template={template} prevTemplate={prev} nextTemplate={next} currentPage="automation" accentColor={accent}>
            <AutomationContent />
        </CrmLayout>
    );
}
