'use client';

import React from 'react';
import { getTemplateBySlug, getAdjacentTemplates } from '@/lib/registry';
import { CrmLayout } from '@/components/crm-layout/CrmLayout';
import { COHORT_RETENTION_A, COHORT_RETENTION_B, SALES_CYCLE_HIST, REP_SCATTER } from '../data';

const bg = '#0a0a0b';
const card: React.CSSProperties = { background: '#17171b', border: '1px solid rgba(255,255,255,0.04)', borderRadius: 8, padding: '20px 24px', transition: 'all 0.25s cubic-bezier(.4,0,.2,1)' };
const lbl: React.CSSProperties = { fontSize: '0.625rem', fontWeight: 700, color: '#4b5563', textTransform: 'uppercase', letterSpacing: '0.08em', marginBottom: 14 };

function AnalyticsContent() {
    const retColor = (v: number) => v >= 90 ? '#22c55e' : v >= 80 ? '#f59e0b' : '#ef4444';
    const maxDeals = Math.max(...REP_SCATTER.map(r => r.deals));
    const maxArr = Math.max(...REP_SCATTER.map(r => r.arr));
    const maxHist = Math.max(...SALES_CYCLE_HIST.map(h => Math.max(h.countA, h.countB)));

    return (
        <div style={{ background: bg, minHeight: '100vh' }}>
            <div style={{ padding: '24px 32px', maxWidth: 1400, margin: '0 auto' }}>
                <div style={{ marginBottom: 20 }}>
                    <h1 style={{ fontSize: '1.375rem', fontWeight: 700, color: '#f9fafb', margin: 0 }}>Variance Intelligence</h1>
                    <p style={{ fontSize: '0.75rem', color: '#4b5563', margin: '4px 0 0' }}>Cohort retention · Revenue composition · Sales cycle · Producer productivity</p>
                </div>

                {/* Hero Metrics */}
                <div style={{ display: 'grid', gridTemplateColumns: 'repeat(3,1fr)', gap: 14, marginBottom: 20 }}>
                    {[
                        { label: 'Forecast Accuracy Δ', value: '+8.1pp', sub: 'A=88.2% vs B=80.1%', color: '#22c55e' },
                        { label: 'KPI Leadership', value: 'A: 6/9', sub: 'B leads on 3 KPIs', color: '#3b82f6' },
                        { label: 'Expansion Δ', value: '+8pp', sub: 'A=22% vs B=14%', color: '#22c55e' },
                    ].map(m => (
                        <div key={m.label} style={{ ...card, cursor: 'default' }}
                            onMouseEnter={e => { (e.currentTarget as HTMLDivElement).style.borderColor = `${m.color}30`; (e.currentTarget as HTMLDivElement).style.transform = 'translateY(-3px)'; (e.currentTarget as HTMLDivElement).style.boxShadow = `0 8px 20px rgba(0,0,0,0.2)`; }}
                            onMouseLeave={e => { (e.currentTarget as HTMLDivElement).style.borderColor = 'rgba(255,255,255,0.04)'; (e.currentTarget as HTMLDivElement).style.transform = 'none'; (e.currentTarget as HTMLDivElement).style.boxShadow = 'none'; }}>
                            <div style={{ fontSize: '0.5rem', fontWeight: 700, color: '#4b5563', textTransform: 'uppercase', letterSpacing: '0.08em', marginBottom: 6 }}>{m.label}</div>
                            <div style={{ fontSize: '2rem', fontWeight: 800, color: m.color, letterSpacing: '-0.03em', lineHeight: 1 }}>{m.value}</div>
                            <div style={{ fontSize: '0.5625rem', color: '#6b7280', marginTop: 6 }}>{m.sub}</div>
                        </div>
                    ))}
                </div>

                {/* Cohort Retention Side-by-Side */}
                <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 20, marginBottom: 20 }}>
                    {[
                        { title: 'Cohort Retention — AMER', data: COHORT_RETENTION_A, color: '#3b82f6' },
                        { title: 'Cohort Retention — EMEA', data: COHORT_RETENTION_B, color: '#8b5cf6' },
                    ].map(panel => (
                        <div key={panel.title} style={{ ...card, borderLeft: `3px solid ${panel.color}30` }}
                            onMouseEnter={e => { (e.currentTarget as HTMLDivElement).style.borderColor = `${panel.color}50`; }}
                            onMouseLeave={e => { (e.currentTarget as HTMLDivElement).style.borderColor = 'rgba(255,255,255,0.04)'; (e.currentTarget as HTMLDivElement).style.borderLeft = `3px solid ${panel.color}30`; }}>
                            <div style={{ ...lbl, color: panel.color }}>{panel.title}</div>
                            <table style={{ width: '100%', borderCollapse: 'separate', borderSpacing: 3 }}>
                                <thead>
                                    <tr>
                                        <th style={{ padding: '4px 6px', fontSize: '0.45rem', color: '#4b5563', textAlign: 'left', fontWeight: 700 }}>Cohort</th>
                                        <th style={{ padding: '4px', fontSize: '0.45rem', color: '#4b5563', textAlign: 'center', fontWeight: 700 }}>M3</th>
                                        <th style={{ padding: '4px', fontSize: '0.45rem', color: '#4b5563', textAlign: 'center', fontWeight: 700 }}>M6</th>
                                        <th style={{ padding: '4px', fontSize: '0.45rem', color: '#4b5563', textAlign: 'center', fontWeight: 700 }}>M12</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {panel.data.map(row => (
                                        <tr key={row.cohort}>
                                            <td style={{ padding: '3px 6px', fontSize: '0.5625rem', color: '#9ca3af', fontWeight: 500 }}>{row.cohort}</td>
                                            {[row.m3, row.m6, row.m12].map((v, ci) => (
                                                <td key={ci} style={{ padding: '2px' }}>
                                                    <div style={{ height: 24, borderRadius: 3, background: `${retColor(v)}15`, display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
                                                        <span style={{ fontSize: '0.5rem', fontWeight: 700, color: retColor(v) }}>{v}%</span>
                                                    </div>
                                                </td>
                                            ))}
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        </div>
                    ))}
                </div>

                {/* Sales Cycle Histogram + Rep Scatter */}
                <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 20 }}>
                    <div style={card}
                        onMouseEnter={e => { (e.currentTarget as HTMLDivElement).style.borderColor = 'rgba(255,255,255,0.1)'; }}
                        onMouseLeave={e => { (e.currentTarget as HTMLDivElement).style.borderColor = 'rgba(255,255,255,0.04)'; }}>
                        <div style={lbl}>Sales Cycle Distribution — A vs B</div>
                        <div style={{ display: 'flex', flexDirection: 'column', gap: 10 }}>
                            {SALES_CYCLE_HIST.map(h => (
                                <div key={h.bucket}>
                                    <div style={{ fontSize: '0.5625rem', color: '#6b7280', marginBottom: 4 }}>{h.bucket}</div>
                                    <div style={{ display: 'flex', gap: 4, alignItems: 'center' }}>
                                        <div style={{ flex: 1, height: 14, background: '#111113', borderRadius: 3, display: 'flex', alignItems: 'center', overflow: 'hidden' }}>
                                            <div style={{ width: `${(h.countA / maxHist) * 100}%`, height: '100%', background: '#3b82f6', borderRadius: 3, opacity: 0.7, transition: 'width 0.3s' }} />
                                        </div>
                                        <span style={{ fontSize: '0.45rem', color: '#3b82f6', fontWeight: 700, width: 24, textAlign: 'right' }}>{h.countA}</span>
                                    </div>
                                    <div style={{ display: 'flex', gap: 4, alignItems: 'center', marginTop: 2 }}>
                                        <div style={{ flex: 1, height: 14, background: '#111113', borderRadius: 3, display: 'flex', alignItems: 'center', overflow: 'hidden' }}>
                                            <div style={{ width: `${(h.countB / maxHist) * 100}%`, height: '100%', background: '#8b5cf6', borderRadius: 3, opacity: 0.7, transition: 'width 0.3s' }} />
                                        </div>
                                        <span style={{ fontSize: '0.45rem', color: '#8b5cf6', fontWeight: 700, width: 24, textAlign: 'right' }}>{h.countB}</span>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>

                    <div style={card}
                        onMouseEnter={e => { (e.currentTarget as HTMLDivElement).style.borderColor = 'rgba(255,255,255,0.1)'; }}
                        onMouseLeave={e => { (e.currentTarget as HTMLDivElement).style.borderColor = 'rgba(255,255,255,0.04)'; }}>
                        <div style={lbl}>Producer Productivity — A vs B</div>
                        <svg width="100%" height="200" viewBox="0 0 300 200">
                            {/* Grid */}
                            {[0, 50, 100, 150, 200].map(y => (
                                <line key={y} x1={30} y1={y} x2={290} y2={y} stroke="rgba(255,255,255,0.04)" strokeWidth={0.5} />
                            ))}
                            {/* Dots */}
                            {REP_SCATTER.map((r, i) => {
                                const cx = 30 + (r.deals / maxDeals) * 250;
                                const cy = 200 - (r.arr / maxArr) * 180;
                                const color = r.segment === 'A' ? '#3b82f6' : '#8b5cf6';
                                return (
                                    <circle key={i} cx={cx} cy={cy} r={r.size / 25} fill={color} opacity={0.6}
                                        style={{ transition: 'all 0.2s', cursor: 'pointer' }}
                                        onMouseEnter={e => { (e.target as SVGCircleElement).setAttribute('opacity', '1'); (e.target as SVGCircleElement).setAttribute('r', String(r.size / 20)); }}
                                        onMouseLeave={e => { (e.target as SVGCircleElement).setAttribute('opacity', '0.6'); (e.target as SVGCircleElement).setAttribute('r', String(r.size / 25)); }}>
                                        <title>{r.name}: {r.deals} deals, ${r.arr}M ARR ({r.segment === 'A' ? 'AMER' : 'EMEA'})</title>
                                    </circle>
                                );
                            })}
                            <text x={160} y={198} textAnchor="middle" fontSize={7} fill="#4b5563">Deals Won →</text>
                            <text x={14} y={100} textAnchor="middle" fontSize={7} fill="#4b5563" transform="rotate(-90 14 100)">ARR ($M) →</text>
                        </svg>
                        <div style={{ display: 'flex', gap: 14, marginTop: 6, justifyContent: 'center' }}>
                            <span style={{ fontSize: '0.5rem', color: '#3b82f6', fontWeight: 600 }}>● AMER</span>
                            <span style={{ fontSize: '0.5rem', color: '#8b5cf6', fontWeight: 600 }}>● EMEA</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    );
}

export default function Analytics11Page() {
    const template = getTemplateBySlug('crm-11');
    if (!template) return null;
    const { prev, next } = getAdjacentTemplates('crm-11');
    return (
        <CrmLayout template={template} prevTemplate={prev} nextTemplate={next} currentPage="analytics" accentColor="#e5e7eb">
            <AnalyticsContent />
        </CrmLayout>
    );
}
